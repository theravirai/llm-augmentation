# Configuration template for LLM-Augmented Java Program Analysis
# Copy this file to .env and configure your keys:
#   cp .env.example .env

# LLM Gateway Endpoint (Uni Paderborn / OpenAI / vLLM / Ollama)
OPENAI_API_BASE=https://ai-gateway.uni-paderborn.de

# API Key for authentication
OPENAI_API_KEY=your_api_key_here

# Default model name
DEFAULT_MODEL=gpt-oss-120b

# Directory for target Java benchmark repositories (defaults to ./workspace)
BENCHMARK_WORKSPACE_DIR=workspace
